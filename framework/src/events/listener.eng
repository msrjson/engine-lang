module Framework::Events::Listener;

type ListenerName = Text where len(value) >= 3;

enum ListenerStatus {
    Handled,
    Skipped,
    Failed
}

struct EventListener {
    name: ListenerName,
    target_event: Text
}

// Action: Create event listener binding
pub action bind_listener(name: ListenerName, target: Text) -> EventListener {
    return EventListener {
        name: name,
        target_event: target
    };
}

// Action: Handle causal event
pub action process_event(listener: &EventListener, event_name: Text) -> Result<ListenerStatus, Text> {
    if listener.target_event != event_name {
        return Ok(ListenerStatus::Skipped);
    }

    return Ok(ListenerStatus::Handled);
}

