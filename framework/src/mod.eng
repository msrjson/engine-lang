module Framework::Core;

// Framework Version and Metadata
type FrameworkVersion = Text where len(value) >= 5;
type FrameworkState = Text where len(value) >= 4;

enum KernelMode {
    Development,
    Production,
    Testing
}

struct AppConfig {
    name: Text,
    version: FrameworkVersion,
    mode: KernelMode,
    boundary_port: Int
}

struct FrameworkKernel {
    config: AppConfig,
    is_booted: Bool
}

// Action: Initialize framework kernel instance
pub action create_kernel(app_name: Text, port: Int) -> Result<FrameworkKernel, Text> {
    if port <= 0 {
        return Err("Invalid boundary gateway port");
    }

    let config = AppConfig {
        name: app_name,
        version: "0.1.0-alpha",
        mode: KernelMode::Development,
        boundary_port: port
    };

    let kernel = FrameworkKernel {
        config: config,
        is_booted: true
    };

    return Ok(kernel);
}

// Action: Kernel bootstrap verification
pub action verify_kernel(kernel: &FrameworkKernel) -> Result<Text, Text> {
    if !kernel.is_booted {
        return Err("Kernel is not booted");
    }

    return Ok("KERNEL_ONLINE");
}

