module Framework::Sls::Repository;

type PageLimit = Int where value >= 1 && value <= 100;
type PageOffset = Int where value >= 0;

struct QueryScope {
    tenant_id: Text,
    limit: PageLimit,
    offset: PageOffset,
    include_archived: Bool
}

struct QueryResult {
    total_found: Int,
    page_count: Int,
    payload_json: Text
}

// Action: Create query scope with pagination
pub action paginate(
    tenant_id: Text,
    limit: PageLimit,
    offset: PageOffset
) -> QueryScope {
    return QueryScope {
        tenant_id: tenant_id,
        limit: limit,
        offset: offset,
        include_archived: false
    };
}

// Action: Format retrieved persistent items into JSON representation
pub action format_result(total: Int, json: Text) -> QueryResult {
    return QueryResult {
        total_found: total,
        page_count: 1,
        payload_json: json
    };
}

