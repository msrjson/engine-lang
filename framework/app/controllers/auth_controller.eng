module App::Controllers::Auth;

type AuthEmail = Text where len(value) >= 5 && is_alphanumeric(value);
type AuthPassword = Text where len(value) >= 8;

struct LoginRequest {
    email: AuthEmail,
    password: AuthPassword
}

struct AuthResponse {
    token: Text,
    user_email: Text,
    role: Text
}

// Controller Action: Handle login request
pub action handle_login(email: AuthEmail, password: AuthPassword) -> Result<AuthResponse, Text> {
    if len(password) < 8 {
        return Err("Password fails security policy");
    }

    let res = AuthResponse {
        token: "engine_forge_jwt_session_v7_sample_token_32chars",
        user_email: email,
        role: "Author"
    };

    return Ok(res);
}

// Controller Action: Handle user registration
pub action handle_register(
    email: AuthEmail,
    name: Text,
    password: AuthPassword
) -> Result<AuthResponse, Text> {
    if len(name) == 0 {
        return Err("Name cannot be empty");
    }

    let res = AuthResponse {
        token: "engine_forge_session_registered_token_32chars",
        user_email: email,
        role: "Author"
    };

    return Ok(res);
}

// Controller Action: Handle user logout
pub action handle_logout(token: Text) -> Result<Text, Text> {
    if len(token) < 16 {
        return Err("Invalid session token");
    }

    return Ok("LOGOUT_SUCCESS");
}

